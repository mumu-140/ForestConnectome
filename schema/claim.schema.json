{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForestConnectomeClaim",
  "type": "object",
  "required": ["claim_id", "subject", "predicate", "object", "evidence_origin", "assertion_status", "provenance"],
  "properties": {
    "claim_id": {"type": "string"},
    "subject": {"$ref": "entity.schema.json"},
    "predicate": {"type": "string"},
    "object": {"$ref": "entity.schema.json"},
    "evidence_origin": {"enum": ["direct", "orthology_transfer", "computational_inference"]},
    "assertion_status": {"enum": ["observed", "inferred", "predicted", "hypothesized", "background"]},
    "evidence_type": {"enum": ["genetic", "biochemical", "binding", "expression", "phenotypic", "computational", "citation_only", "other"]},
    "species_scope": {"enum": ["exact_species", "genus", "multi_species", "inferred_from_context", "unspecified"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": {"type": "string"},
        "pmid": {"type": ["string", "null"]},
        "doi": {"type": ["string", "null"]},
        "chunk_id": {"type": ["string", "null"]},
        "evidence_text": {"type": ["string", "null"]},
        "extractor_version": {"type": ["string", "null"]}
      }
    },
    "transfer": {"$ref": "transfer.schema.json"}
  }
}
